{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartMotionSuggestions",
  "type": "object",
  "required": ["meaning_confidence", "suggestions"],
  "additionalProperties": false,
  "properties": {
    "meaning_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "How confident the model is about the icon's meaning/part roles."
    },
    "suggestions": {
      "type": "object",
      "required": ["corporate", "educational", "dynamic"],
      "additionalProperties": false,
      "properties": {
        "corporate": { "$ref": "#/definitions/suggestion" },
        "educational": { "$ref": "#/definitions/suggestion" },
        "dynamic": { "$ref": "#/definitions/suggestion" }
      }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": ["ar", "en"],
      "additionalProperties": false,
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "part_motion": {
      "type": "object",
      "required": ["part", "motion", "params"],
      "additionalProperties": false,
      "properties": {
        "part": { "type": "string", "description": "A part label present in the icon report." },
        "motion": { "type": "string", "description": "A token from vocabulary.motions.*" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        }
      }
    },
    "suggestion": {
      "type": "object",
      "required": ["title", "meaning", "parts_motion", "global", "explanation"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/definitions/bilingual" },
        "meaning": { "$ref": "#/definitions/bilingual" },
        "parts_motion": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/part_motion" }
        },
        "global": {
          "type": "object",
          "required": ["duration_s", "easing", "stagger", "style", "loop"],
          "additionalProperties": false,
          "properties": {
            "duration_s": { "type": "number", "minimum": 0.3, "maximum": 6.0 },
            "easing": { "type": "string" },
            "stagger": {
              "type": "object",
              "required": ["order", "seconds"],
              "additionalProperties": false,
              "properties": {
                "order": { "type": "string" },
                "seconds": { "type": "number", "minimum": 0.0, "maximum": 0.5 }
              }
            },
            "style": { "type": "string" },
            "loop": { "type": "boolean" }
          }
        },
        "explanation": { "$ref": "#/definitions/bilingual" }
      }
    }
  }
}
