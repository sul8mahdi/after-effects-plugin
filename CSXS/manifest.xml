<?xml version="1.0" encoding="UTF-8"?>
<!--
  CEP manifest for Icon M Pro.
  HostList AEFT version range covers After Effects 2024 (24.x) .. future (99.9),
  which includes After Effects 2026 (26.x). CEP runtime 11.x ships with AE 2026.
-->
<ExtensionManifest Version="11.0"
                   ExtensionBundleId="com.iconmpro.app"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Icon M Pro"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.iconmpro.app.panel" Version="0.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[24.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.iconmpro.app.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Icon M Pro</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
